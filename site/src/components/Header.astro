---
import Burst from './Burst.astro';
import GitHub from './GitHub.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const exact = nav.some((n) => n.href === path);
const current = (h: string) => (h === path || (h === '/docs/' && !exact && path.startsWith('/docs/')) ? 'page' : undefined);
---
<header class="head">
  <div class="wrap head__bar">
    <a class="head__name wordmark lock" href="/" aria-label="Bluelines, home">Bluelines<span class="cursor" aria-hidden="true">_</span></a>
    <a class="head__logo" href="/" aria-label="Bluelines, home"><Burst size={36} id="head-logo" /></a>
    <div class="head__right">
    <nav class="head__nav" aria-label="Main">
      <ul>
        {nav.map((n) => <li><a class="navlink lock" href={n.href} aria-current={current(n.href)}>{n.short ? <><span class="nav__long">{n.label}</span><span class="nav__short" aria-hidden="true">{n.short}</span></> : n.label}</a></li>)}
      </ul>
    </nav>
    <button class="theme-toggle lock" type="button" data-theme-toggle aria-label="Switch between white and dark mode">
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" stroke-linejoin="round"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="btn btn--primary btn--sm lock head__cta" href={site.github.href} rel="noopener"><GitHub size={16} /><span>GitHub</span></a>
    </div>
  </div>
</header>

<!-- The dock: the extension's floating bar, driving this page's demo. -->
<div class="dock" data-dock role="toolbar" aria-label="Bluelines demo">
  <span class="dock__mark" aria-hidden="true"><Burst size={22} /></span>
  <button class="dock__btn" type="button" data-inspect-toggle aria-pressed="false" aria-keyshortcuts="Alt+Shift+M">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4l6.5 16 2.3-6.7L19.5 11z" stroke-linejoin="round"/></svg>
    Inspect
  </button>
  <button class="dock__btn dock__btn--icon" type="button" data-notes-jump aria-label="Notes: jump to the next note">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z" stroke-linejoin="round"/></svg>
    <span class="dock__badge" data-notes-count>0</span>
  </button>
  <a class="dock__btn dock__btn--icon" href="/docs/table-view/" aria-label="Table view (docs)">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M3.5 9.5h17M9.5 9.5v10M15 9.5v10"/></svg>
  </a>
</div>
